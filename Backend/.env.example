# CORS — required for a Vercel-hosted frontend calling this API.
# Comma-separated origins (no trailing slash). Localhost is always allowed for dev.
CORS_ORIGINS=https://your-project.vercel.app
# Optional single origin (merged with CORS_ORIGINS):
# FRONTEND_URL=https://your-project.vercel.app
# Vercel preview deployments (*.vercel.app); escape backslashes in .env if needed:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Open to any origin (no credentialed cross-origin requests): CORS_ALLOW_ALL=true

# GA4 / Drive service account JSON:
# - Docker: path inside container, e.g. /app/secrets/ga4-credentials.json
# - Local: put ga4-credentials.json in Backend/ and either omit GA4_CREDENTIALS or set a relative name, e.g. ga4-credentials.json
#   (Avoid paths like /Backend/... — that is not your project folder on Windows.)
GA4_CREDENTIALS=/app/secrets/ga4-credentials.json
GOOGLE_ADS_YAML=/app/secrets/google-ads.yaml
