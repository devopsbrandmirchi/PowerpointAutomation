# Copy to .env.development / .env.production.local or set in Vercel / Netlify.
# Never commit real keys to git.

# FastAPI (no trailing slash). On Vercel, set this to your deployed API base URL
# and add the same origin to Backend CORS_ORIGINS (or CORS_ORIGIN_REGEX for previews).
VITE_API_URL=http://127.0.0.1:8000

# Supabase (Settings → API → Project URL + anon public key)
SUPABASE_URL=
SUPABASE_KEY=

# Optional: must match Backend SUPABASE_CLIENT_TABLE if you use a custom dealer table
# VITE_SUPABASE_CLIENT_TABLE=google_ads_accounts

# Idle timeout (ms) before auto sign-out on dashboard. Default 1800000 (30 min). 0 = off.
# VITE_SESSION_IDLE_MS=1800000

# true = session in sessionStorage (new window usually requires login again)
# VITE_AUTH_USE_SESSION_STORAGE=false

# false = no persisted session (browser refresh = login again)
# VITE_AUTH_PERSIST_SESSION=true
